{
  "redirects": [
    {
      "source": "/:path.html",
      "destination": "/:path",
      "permanent": true
    },
    {
      "source": "/src/:path.html",
      "destination": "/src/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/src/account",
      "destination": "/src/account.html"
    },
    {
      "source": "/src/board",
      "destination": "/src/board.html"
    },
    {
      "source": "/src/footer-pages",
      "destination": "/src/footer-pages.html"
    },
    {
      "source": "/src/slide-admin",
      "destination": "/src/slide-admin.html"
    },
    {
      "source": "/src/slide-view",
      "destination": "/src/slide-view.html"
    },
    {
      "source": "/src/web-view",
      "destination": "/src/web-view.html"
    }
  ]
}